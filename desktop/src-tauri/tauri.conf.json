{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raven",
  "version": "0.1.0",
  "identifier": "com.raven.local",
  "build": {
    "beforeBuildCommand": "cd ../dashboard && npm run build",
    "beforeDevCommand": "cd ../dashboard && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../dashboard/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Raven",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/python/**/*",
      "resources/raven/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/jaekanglee/RavenCode/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0MTEyQzIzQUJFODZGREQKUldUZGIraXJJeXdSVkRURWdmY0F0TzhXRkdnRG5YK09GRGZhTnpNay95S2F3eEZTbmJ0UzM2cTEK"
    }
  }
}
