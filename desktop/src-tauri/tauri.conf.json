{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raven",
  "version": "0.3.11",
  "identifier": "com.raven.local",
  "build": {
    "beforeBuildCommand": "cd ../dashboard && npm run build",
    "beforeDevCommand": "cd ../dashboard && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../dashboard/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Raven",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' data: blob: http: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' data: blob: http: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/python/**/*",
      "resources/raven/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/jaekanglee/RavenCode/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0MTEyQzIzQUJFODZGREQKUldUZGIraXJJeXdSVkRURWdmY0F0TzhXRkdnRG5YK09GRGZhTnpNay95S2F3eEZTbmJ0UzM2cTEK"
    }
  }
}
