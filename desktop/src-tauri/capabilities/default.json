{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Raven desktop default capability — allow the webview to query the managed Python Core / MCP endpoints.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-core-endpoint",
    "allow-core-session-token",
    "allow-mcp-endpoint",
    "allow-core-status",
    "allow-restart-core",
    "allow-save-download-file",
    "allow-save-download-file-as",
    "allow-app-version",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
