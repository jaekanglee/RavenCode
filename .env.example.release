# 데스크톱 릴리스 서명 설정 — `.env.release` 로 복사해서 사용한다.
#   cp .env.example.release .env.release && chmod 600 .env.release
# 또는 대화형으로: make desktop-key-save
#
# .env.release 는 .gitignore 에 있다. 절대 커밋하지 말 것.
# make desktop-release / scripts/sign-update.sh 가 자동으로 읽는다.

# 업데이터 서명 개인키 — 파일 경로 또는 키 문자열 둘 다 허용
TAURI_SIGNING_PRIVATE_KEY=$HOME/.tauri/raven.key

# 키 생성 시 설정한 비밀번호. 비밀번호 없는 키면 빈 문자열('')로 둔다.
# 값에 따옴표·공백·$ 가 있을 수 있으니 항상 작은따옴표로 감싼다.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=''
